
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Overlay permission for the floating EdgeKit panel -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Required for foreground services -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Required for the special-use foreground service type -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notifications for the foreground service -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:supportsRtl="true">

        <service
            android:name="com.edgekit.EdgePanelService"
            android:enabled="true"
            android:exported="false"
           android:foregroundServiceType="1073741824">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated floating shortcut panel" />

        </service>

    </application>

</manifest>
